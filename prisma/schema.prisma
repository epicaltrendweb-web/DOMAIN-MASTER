// DOMAIN-MASTER — Prisma schema
// Domain availability tracking + free domain discovery

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A domain the user is tracking (saved search result).
model TrackedDomain {
  id           String   @id @default(cuid())
  name         String   // full domain name, e.g. "myproject.dev"
  tld          String   // extension without dot, e.g. "dev"
  status       String   @default("unknown") // "available" | "taken" | "unknown" | "error"
  registrar    String?
  registeredAt DateTime?
  expiresAt    DateTime?
  lastChecked  DateTime?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  checks       CheckLog[]

  @@unique([name])
  @@index([tld])
  @@index([status])
}

/// History of availability checks for a tracked domain.
model CheckLog {
  id          String   @id @default(cuid())
  domainId    String
  status      String   // "available" | "taken" | "unknown" | "error"
  available   Boolean?
  registrar    String?
  errorMessage String?
  responseTime Int?    // milliseconds
  checkedAt   DateTime @default(now())

  domain      TrackedDomain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@index([domainId])
  @@index([checkedAt])
}
